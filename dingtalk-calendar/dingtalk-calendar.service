[Unit]
Description=DingTalk received messages for personal Google Calendar
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/share/dingtalk-calendar
ExecStart=%h/.local/bin/dws event consume user_im_message_receive_o2o_all user_im_message_receive_group_all --flatten --output-dir %h/.local/share/dingtalk-calendar/inbox --duration 24h --format json
Restart=always
RestartSec=30
KillMode=mixed
TimeoutStopSec=45
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
